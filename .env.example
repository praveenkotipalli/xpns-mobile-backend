# Neon connection string — Dashboard > your project > Connection Details > "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

JWT_EXPIRES_IN=30d
PORT=4000
NODE_ENV=development
